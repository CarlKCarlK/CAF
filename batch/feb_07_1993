sub OPEN_CLIENT {
local($them,$port) = @_;
local($client);

# If $maxlines is negative, then no limit.

#open(OUT,$fileout);

$port = 2345 unless $port;
$them = 'localhost' unless $them;

$AF_INET =2;
$SOCK_STREAM = 1;

