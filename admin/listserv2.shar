#include "listserv.h"
static char rcsid[] = "$Header: /tempf/aem/system/listserv/RCS/subscribe.c,v 1.2 91/06/18 14:08:02 aem Exp $";
X
extern FILE *msg;
extern FILE *mailer;
X
subscription(from,command,add)
char *from,*command;
int add;
X	{
X	FILE *list;
X	FILE *listtmp;
X	char grp[256];
X	char adr[256];
X	char tmp[256];
X	char buf[BUFSIZ];
X	int del = 0;
X	int i;
X
X	printf("subscription %s %s %d\n", from, command, add);
X
X	i = sscanf(command,"%s%s%s", tmp, adr, grp);
X	if (i < 2 || i > 3)
X		{
X		callmailer("", from, command);
X		fprintf(mailer,"Your command\n");
X		fprintf(mailer,"\t%s\n", command);
X		fprintf(mailer,"could not be understood.  Correct syntax is\n");
X		fprintf(mailer,"\tADD listname\n");
X		fprintf(mailer,"\tADD mailbox listname\n");
X		fprintf(mailer,"\tDELETE listname\n");
X		fprintf(mailer,"\tDELETE mailbox listname\n");
X		fflush(mailer);
X		pclose(mailer);
X		return(-1);
X		}
X
X	if (i == 2)
X		{
X		strcpy(grp, adr);
X		strcpy(adr, from);
X		}
X	
X	cleanup(grp);
X	cleanup(adr);
X
X	sprintf(tmp,"%s/%s.info", SERVDIR, grp);
X	if (access(tmp,R_OK) != 0)
X		{
X		callmailer("", from, "");
X		fprintf(mailer,"The mailing list \"%s\" could not be found.\n",
X			grp);
X		fprintf(mailer,"You may use the INDEX command to get a listing\n");
X		fprintf(mailer,"of available mailing lists.\n");
X		fflush(mailer);
X		pclose(mailer);
X		return(-1);
X		}
X
X	strcpy(tmp, SERVDIR);
X	strcat(tmp, "/");
X	strcat(tmp, grp);
X	if (add)
X		{
X		list = fopen(tmp, "a");
X		if (list == NULL)
X			{
X			callmailer("Postmaster", from, "");
X			fprintf(mailer,"Couldn't add per request. (Error[1]) Please try later.\n");
X			fprintf(mailer,">%s\n", command);
X			fflush(mailer);
X			pclose(mailer);
X			return(-1);
X			}
X		flock(fileno(list), LOCK_EX);
X		fprintf(list, "%s\n", adr);
X		fflush(list);
X		flock(fileno(list), LOCK_UN);
X		fclose(list);
X		}
X	else
X		{
X		del = 0;
X		list = fopen(tmp, "r");
X		if (list == NULL)
X			{
X			callmailer("Postmaster", from, "");
X			fprintf(mailer,"Couldn't read subscription list.  (Error[2]). Please try later.\n");
X			fprintf(mailer,">%s\n", command);
X			fflush(mailer);
X			pclose(mailer);
X			return(-1);
X			}
X		flock(fileno(list), LOCK_EX);
X		fprintf(list, "%s\n", adr);
X
X		strcpy(tmp, SERVDIR);
X		strcat(tmp, "/");
X		strcat(tmp, grp);
X		strcat(tmp, ".tmp");
X		listtmp = fopen(tmp, "w");
X		if (listtmp == NULL)
X			{
X			callmailer("Postmaster", from, "");
X			fprintf(mailer,"Couldn't write subscription list (Error[3]). Please try later.\n");
X			fprintf(mailer,">%s\n", command);
X			fflush(mailer);
X			pclose(mailer);
X			return(-1);
X			}
X		/* copy the list, omitting the one address */
X		while (fgets(buf, sizeof(buf), list))
X			{
X			buf[strlen(buf)-1] = '\0';
X			if (strcasecmp(buf, adr))
X				{
X				fputs(buf, listtmp);
X				fputs("\n", listtmp);
X				}
X			else
X				del++;
X			}
X		fflush(listtmp);
X		fclose(listtmp);
X
X		/* replace the old list with the shortened one */
X		strcpy(buf, SERVDIR);
X		strcat(buf, "/");
X		strcat(buf, grp);
X		unlink(buf);	/* delete original file */
X		rename(tmp, buf);	/* put updated one in place */
X		flock(fileno(list), LOCK_UN);	/* release lock */
X		}
X
X	if (strcmp(from, adr))
X		{
X		callmailer(adr, from, command);
X		fprintf(mailer,"Per request by %s\n", from);
X		}
X	else
X		{
X		callmailer("", from, command);
X		fprintf(mailer,"Per your request\n");
X		}
X	fprintf(mailer,"\t\"%s\"\n", command);
X	if (add)
X		fprintf(mailer,"'%s' was ADDED to the '%s' mailing list.\n",
X			adr, grp);
X	else
X		if (del)
X			fprintf(mailer,
X			"'%s' was DELETED from the '%s' mailing list.\n",
X				adr, grp);
X		else
X			fprintf(mailer,
X			"'%s' was NOT FOUND on the '%s' mailing list.\n",
X				adr, grp);
X	fflush(mailer);
X	pclose(mailer);
X	}
SHAR_EOF
chmod 0440 subscribe.c ||
echo 'restore of subscribe.c failed'
Wc_c="`wc -c < 'subscribe.c'`"
test 3631 -eq "$Wc_c" ||
	echo 'subscribe.c: original size 3631, current size' "$Wc_c"
fi
# ============= example-files/HELP ==============
if test ! -d 'example-files'; then
    echo 'x - creating directory example-files'
    mkdir 'example-files'
fi
if test -f 'example-files/HELP' -a X"$1" != X"-c"; then
	echo 'x - skipping example-files/HELP (File already exists)'
else
echo 'x - extracting example-files/HELP (Text)'
sed 's/^X//' << 'SHAR_EOF' > 'example-files/HELP' &&
X
You can subscribe or unsubscribe to any of the various campus mailing
lists and the local redistributions of global mailing lists by sending
email to "listserv@mthvax.cs.miami.edu".  The commands understood by 
the listserv program are:
X
HELP
X	lists this file.  This is also sent whenever a message to
X	listserv is received from which no valid command could be
X	parsed.
X
HELP groupname
X	lists a brief description of the group requested.
X
INDEX
X	lists all the groups available for subscription.
X
LONGINDEX
X	lists all the groups and their descriptions.
X
ADD listname	 
DELETE listname	
X
ADD address listname	 
DELETE address listname	
X	adds or deletes the given address to or from the list
X	specified.  Mail is sent to the address given to confirm
X	the add or delete operation.  We strongly recommend that
X	you use your campus registered mailname when subscribing
X	(i.e., use the second form of the command which includes
X	a specification of the address).  If you omit the 'address'
X	the command will assume the mailbox that is in the From:
X	line of the message.  Note that SUBSCRIBE is a synonym for
X	ADD; UNSUBSCRIBE for DELETE.
X
A command must be the first word on each line in the message.  Lines
which do not start with a command word are ignored.  If no commands were
found in the entire message, this help file will be returned to the
user.  A single message may contain multiple commands; a separate
response will be sent for each.
X
Please note that is IS possible to add or delete someone else's
subscription to a mailing list.  This facility is provided so that
subscribers may alter their own subscriptions from a new or different
computer account.  There is therefore some potential for abuse; we
have chosen to limit this by mailing a confirmation notification
of any addition or deletion to the address added or deleted including
a copy of the message which requested the operation.  At least you
can find out who's doing it to you.
X
Examples:
X
X	add sunusers
X
X	add ewombat foodlovers
X
X	delete wombat@miami.miami.edu connectionists
X
X	help eggbeaters
X
Note that although you would mail submissions to a campus mailing list by
addressing mail to e.g., sunflash@mthvax.cs.miami.edu, in a
subscription request you specify the name of the list simply (without
the @hostname part) as in the first example above.
X
SHAR_EOF
chmod 0600 example-files/HELP ||
echo 'restore of example-files/HELP failed'
Wc_c="`wc -c < 'example-files/HELP'`"
test 2319 -eq "$Wc_c" ||
	echo 'example-files/HELP: original size 2319, current size' "$Wc_c"
fi
# ============= example-files/info-hams.info ==============
if test -f 'example-files/info-hams.info' -a X"$1" != X"-c"; then
	echo 'x - skipping example-files/info-hams.info (File already exists)'
else
echo 'x - extracting example-files/info-hams.info (Text)'
sed 's/^X//' << 'SHAR_EOF' > 'example-files/info-hams.info' &&
info-hams
X			Welcome to Info-Hams!
X	You are invited to send comments and queries regarding Ham Radio
X	operation and related subjects to Info-Hams@UCSD.EDU
X	
X	To subscribe or unsubscribe, send mail to "listserv@ucsd.edu".
X	
X	If you wish to discuss matters dealing solely with the operation of the
X	Info-Hams mailing list (mail delivery problems, policy questions,
X	etc.), please address such correspondence to Info-Hams-Relay@UCSD.EDU.
X	
X	The mail archives on UCSD.EDU (available by anonymous ftp) for this
X	list are:
X		mailarchives/info-hams/Vyy.nn for the current messages
X		mailarchives/info-nams/yymm.n-TXT for the older messages
X	
X	You will note most files have a .Z at the end of the filetype.  These
X	are compressed with a Unix-compatible compress program.  They should
X	FTP'd in binary mode.
X	
X	The mailing list is in the form of a digest.  It is not edited, just a
X	convenient envelope for multiple messages to reduce netmail load.
X	------------
X	Attention BITNET PEOPLE:
X	You may delete yourself from the list by sending the command:
X	      SIGNOFF DIST-HAM
X	to LISTSERV@RPIECS.
X	You may add yourself to the list by sending the following command:
X	      SUBSCRIBE DIST-HAM your full name
X	to LISTSERV@RPIECS.  You can send these interactively if your system
X	supports that (e.g. the CMS TELL command), or in the body of a mail message
X	(*not* the subject line).
X	
X	Although you'll be receiving Info-Hams mailing from the network address
X	DIST-HAM@RPIECS, Info-Hams@UCSD.EDU is the source.  Any contributions
X	from you should be sent to UCSD.
X
SHAR_EOF
chmod 0644 example-files/info-hams.info ||
echo 'restore of example-files/info-hams.info failed'
Wc_c="`wc -c < 'example-files/info-hams.info'`"
test 1552 -eq "$Wc_c" ||
	echo 'example-files/info-hams.info: original size 1552, current size' "$Wc_c"
fi
# ============= example-files/packet-radio.info ==============
if test -f 'example-files/packet-radio.info' -a X"$1" != X"-c"; then
	echo 'x - skipping example-files/packet-radio.info (File already exists)'
else
echo 'x - extracting example-files/packet-radio.info (Text)'
sed 's/^X//' << 'SHAR_EOF' > 'example-files/packet-radio.info' &&
packet-radio
X	The packet-radio mailing list; gatewayed to/from the USENET newsgroup
X	rec.ham-radio.packet.
X	
X	SPECIAL NOTE FOR BITNET PEOPLE: UCSD.EDU is an internet site.  The
X	Internet-to-BITNET mail gateway systems would prefer that you instead
X	add yourself to a BITNET redistribution of this list; you may add
X	yourself to the list by sending the following command:
X	
X	      SUBSCRIBE I-PACRAD your full name
X	
X	to LISTSERV@UIUCVMD.  You can send that interactively if your system
X	supports that (e.g. the CMS TELL command), or in the body of a mail
X	message (*not* the subject line).
X	
X	Please note:  Although you'll be receiving the Packet-Radio mailing
X	from the network address I-PACRAD@UIUCVMD, Packet-Radio@UCSD.Edu is the
X	source.  Any contributions from you should be sent to UCSD.
X	
X	Problems, comments, complaints can be sent to me at the address below.
X	
X	The mailing list is in the form of a digest.  It is not edited, just
X	a convenient envelope for multiple messages to reduce netmail load.
X
SHAR_EOF
chmod 0644 example-files/packet-radio.info ||
echo 'restore of example-files/packet-radio.info failed'
Wc_c="`wc -c < 'example-files/packet-radio.info'`"
test 1011 -eq "$Wc_c" ||
	echo 'example-files/packet-radio.info: original size 1011, current size' "$Wc_c"
fi
exit 0
