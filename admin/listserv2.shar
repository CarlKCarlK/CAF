#
# Makefile for UCSD listserv
#
# $Header: /tempf/aem/listserv/RCS/Makefile,v 1.4 91/06/17 17:06:34 aem Exp $
X
CC = cc
CFLAGS = -g
INSTALLDIR = /usr/local/mail
X
all:	listserv
X
install:	all
X	install -c -m 2711 -g mail listserv $(INSTALLDIR)
X
listserv:	main.o commands.o subscribe.o str.o
X	$(CC) -O -o listserv main.o commands.o subscribe.o str.o
X
main.o:	main.c listserv.h
X	$(CC) -c $(CFLAGS) main.c
X
commands.o:	commands.c listserv.h
X	$(CC) -c $(CFLAGS) commands.c
X
subscribe.o:	subscribe.c listserv.h
X	$(CC) -c $(CFLAGS) subscribe.c
X
str.o:	str.c
X	$(CC) -c $(CFLAGS) str.c
X
clean:
X	@rm -f listserv main.o commands.o subscribe.o str.o core
X
shar:
X	@rm -f listserv.shar
X	shar README Makefile *.h *.c example-files >listserv.shar
